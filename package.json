{
  "name": "dsh-cli-inventory",
  "version": "1.0.0",
  "description": "DeepSeek Harness 命令行资产清册：全景可视化体检系统 CLI 装备库，支持健康状态探测、登录态检测、一键复制安装及环境报告导出。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cli",
    "inventory",
    "dashboard",
    "terminal",
    "system-tools",
    "diagnostics"
  ],
  "author": "Movingtoleveltwo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Movingtoleveltwo/dsh-cli-inventory.git"
  },
  "homepage": "https://github.com/Movingtoleveltwo/dsh-cli-inventory#readme",
  "bugs": {
    "url": "https://github.com/Movingtoleveltwo/dsh-cli-inventory/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1"
  }
}
